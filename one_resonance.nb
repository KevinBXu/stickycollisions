Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "4"}], "y", " ", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "z"}], " ", 
        RowBox[{"y", "/", "2"}]}]], 
      RowBox[{
       SqrtBox[
        RowBox[{"2", " ", "\[Pi]"}]], " ", 
       SqrtBox[
        RowBox[{"z", " ", "y"}]]}]], "."}]}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "->", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.958841790622652*^9, 
  3.9588417920957527`*^9}},ExpressionUUID->"0700fecb-aa14-5a44-b8a8-\
c1213ef1b04d"],

