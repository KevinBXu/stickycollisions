 CellLabel->"In[29]:=",ExpressionUUID->"70e4af60-b302-ae43-9fe7-b1d2b705945c"],

Cell["\<\
\\frac{e^{-c d^2} \\left(\\Gamma \\left(\\frac{3}{4}\\right) \\, _1F_1\\left(\
\\frac{3}{4};\\frac{1}{2};c d^2\\right)+2 \\sqrt{c} d \\Gamma
   \\left(\\frac{5}{4}\\right) \\, _1F_1\\left(\\frac{5}{4};\\frac{3}{2};c \
d^2\\right)\\right)}{2 c^{3/4}}\
\>", "Output",
 CellChangeTimes->{3.9588445165082264`*^9},
