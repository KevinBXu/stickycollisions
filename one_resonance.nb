      SqrtBox["s"], " ", 
      SqrtBox["x"]}]], "/.", 
    RowBox[{"{", 
     RowBox[{"s", "->", "100"}], "}"}]}], ",", 
   RowBox[{"x", "->", "0"}]}], "]"}]], "Input",
