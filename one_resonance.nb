Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "c"}], " ", 
     SuperscriptBox["d", "2"]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Gamma", "[", 
       FractionBox["3", "4"], "]"}], " ", 
      RowBox[{"Hypergeometric1F1", "[", 
       RowBox[{
        FractionBox["3", "4"], ",", 
        FractionBox["1", "2"], ",", 
        RowBox[{"c", " ", 
         SuperscriptBox["d", "2"]}]}], "]"}]}], "+", 
     RowBox[{"2", " ", 
      SqrtBox["c"], " ", "d", " ", 
      RowBox[{"Gamma", "[", 
       FractionBox["5", "4"], "]"}], " ", 
      RowBox[{"Hypergeometric1F1", "[", 
       RowBox[{
        FractionBox["5", "4"], ",", 
        FractionBox["3", "2"], ",", 
        RowBox[{"c", " ", 
         SuperscriptBox["d", "2"]}]}], "]"}]}]}], ")"}]}], 
  RowBox[{"2", " ", 
   SuperscriptBox["c", 
    RowBox[{"3", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{
  3.9588433383678417`*^9, 3.9588433925650597`*^9, {3.958844453739668*^9, 
   3.958844469243927*^9}},
 CellLabel->"Out[28]=",ExpressionUUID->"7f0cc930-75cd-6b41-ae5d-bfbc86e05e1f"]
}, Open  ]],

