Cell[BoxData[
 RowBox[{"eq", " ", "=", " ", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "c"}], " ", 
        SuperscriptBox["d", "2"]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Gamma", "[", 
          FractionBox["3", "4"], "]"}], " ", 
         RowBox[{"Hypergeometric1F1", "[", 
          RowBox[{
           FractionBox["3", "4"], ",", 
           FractionBox["1", "2"], ",", 
           RowBox[{"c", " ", 
            SuperscriptBox["d", "2"]}]}], "]"}]}], "+", 
        RowBox[{"2", " ", 
         SqrtBox["c"], " ", "d", " ", 
         RowBox[{"Gamma", "[", 
          FractionBox["5", "4"], "]"}], " ", 
         RowBox[{"Hypergeometric1F1", "[", 
          RowBox[{
           FractionBox["5", "4"], ",", 
           FractionBox["3", "2"], ",", 
           RowBox[{"c", " ", 
            SuperscriptBox["d", "2"]}]}], "]"}]}]}], ")"}]}], 
     RowBox[{"2", " ", 
      SuperscriptBox["c", 
       RowBox[{"3", "/", "4"}]]}]], "*", 
    RowBox[{
     RowBox[{
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"alpha", "^", "2"}]}], " ", 
         RowBox[{
          RowBox[{"z", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"8", " ", 
            RowBox[{"x", "^", "4"}], " ", 
            RowBox[{"m", "^", "2"}]}], ")"}]}]}], ")"}]}], "/", 
      RowBox[{"Sqrt", "[", "z", "]"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "Pi", " ", "alpha", " ", "x", " ", 
       RowBox[{"m", "^", "2"}]}], ")"}]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "->", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"alpha", "^", "2"}], " ", 
         RowBox[{"x", "^", "4"}], " ", 
         RowBox[{"m", "^", "2"}]}], ")"}]}]}], ",", 
     RowBox[{"d", "->", 
      RowBox[{
       RowBox[{"alpha", "^", "2"}], " ", 
       RowBox[{"z", "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          RowBox[{"x", "^", "2"}]}], ")"}]}]}]}]}], "}"}]}]}]], "Input",
