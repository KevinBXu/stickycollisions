            RowBox[{
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["z", "2"]}], 
            RowBox[{"16", " ", 
             SuperscriptBox["d", "2"], " ", 
             SuperscriptBox["x", "4"]}]]}], "]"}]}], ")"}]}]}], 
     ")"}]}]}]}]], "Output",
