Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"res", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", "y", "]"}], 
     RowBox[{"E", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "^", "2"}], " ", 
            RowBox[{"y", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"a", "^", "2"}], " ", "z", " ", "y"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          RowBox[{"a", "^", "2"}], " ", 
          RowBox[{"x", "^", "2"}], " ", 
          RowBox[{"d", "^", "2"}]}], ")"}]}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", ">", "0"}], ",", 
       RowBox[{"x", ">", "0"}], ",", 
       RowBox[{"d", ">", "0"}], ",", 
       RowBox[{"z", ">", "0"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9814894942098637`*^9, 3.981489545930214*^9}, {
