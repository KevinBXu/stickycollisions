Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", 
     SqrtBox["2"], " ", 
     SuperscriptBox["x", "3"], " ", 
     SqrtBox["z"]}]], 
   RowBox[{"a", " ", 
    SuperscriptBox["\[ExponentialE]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["z", "2"]}], 
      RowBox[{"16", " ", 
       SuperscriptBox["d", "2"], " ", 
       SuperscriptBox["x", "4"]}]]], " ", "\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["z", "2"], " ", 
       RowBox[{"BesselI", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "4"]}], ",", 
         FractionBox[
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["z", "2"]}], 
          RowBox[{"16", " ", 
           SuperscriptBox["d", "2"], " ", 
           SuperscriptBox["x", "4"]}]]}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"8", " ", 
          SuperscriptBox["d", "2"], " ", 
          SuperscriptBox["x", "4"]}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["z", "2"]}]}], ")"}], " ", 
       RowBox[{"BesselI", "[", 
        RowBox[{
         FractionBox["1", "4"], ",", 
         FractionBox[
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["z", "2"]}], 
          RowBox[{"16", " ", 
           SuperscriptBox["d", "2"], " ", 
           SuperscriptBox["x", "4"]}]]}], "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["a", "2"], " ", 
       SuperscriptBox["z", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"BesselI", "[", 
          RowBox[{
           FractionBox["3", "4"], ",", 
           FractionBox[
            RowBox[{
             SuperscriptBox["a", "2"], " ", 
             SuperscriptBox["z", "2"]}], 
            RowBox[{"16", " ", 
             SuperscriptBox["d", "2"], " ", 
             SuperscriptBox["x", "4"]}]]}], "]"}], "-", 
         RowBox[{"BesselI", "[", 
          RowBox[{
           FractionBox["5", "4"], ",", 
